APP_NAME=be-vita-hot-engine
APP_ENV=develop

# Docker published port bind address.
# 127.0.0.1 = only host machine can access http://127.0.0.1:18000
# 0.0.0.0   = external machines can access http://服务器IP:18000
APP_HOST=127.0.0.1

APP_PORT=18000
APP_LOG_DIR=/data/logs/be-vita-hot-engine

HOT_API_TOKEN=4gqTA4cx5X*#I6QG
HOT_HTTP_TIMEOUT=8